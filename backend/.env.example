# Choose one provider. If both are set, DashScope is used first.

# DashScope / Qwen, OpenAI-compatible endpoint
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_MODEL=qwen-plus

# OpenAI
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4.1-mini

# Optional controls
LLM_TIMEOUT_SECONDS=20
# LLM_INTENT_DISABLE_LLM=1

# AMap / Gaode web service
AMAP_WEB_KEY=your_amap_web_key
AMAP_WEB_BASE_URL=https://restapi.amap.com
AMAP_WEB_TIMEOUT_SECONDS=20
